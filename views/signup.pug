extends layout

block body
  main.auth
    .auth-card
      .auth-brand
        +icon('cloud')
        span FileUploader
      h1 Create your account
      p.muted Start organizing your files in folders.

      if errors && errors.length
        .alert.alert-error(role="alert")
          ul
            each e in errors
              li= e.msg

      form.stack(method="POST" action="/users/signup")
        +csrf
        .field
          label(for="username") Username
          input#username(type="text" name="username" value=values.username autocomplete="username" minlength="3" maxlength="30" autofocus required)
        .field
          label(for="password") Password
          input#password(type="password" name="password" autocomplete="new-password" minlength="8" required)
          small.hint At least 8 characters
        .field
          label(for="confirmPassword") Confirm password
          input#confirmPassword(type="password" name="confirmPassword" autocomplete="new-password" required)
        button.btn.btn-primary.btn-block(type="submit") Create account

      p.auth-alt.muted Already have an account?
        |
        |
        a(href="/users/login") Log in
