include _icons

doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(name="csrf-token" content=csrfToken)
    meta(name="color-scheme" content="light dark")
    title #{title ? title + ' · ' : ''}FileUploader
    link(rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%234f46e5' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z'/%3E%3C/svg%3E")
    link(rel="stylesheet" href="/stylesheets/style.css")
  body
    block body

    #toasts(aria-live="polite" aria-atomic="false")
      each f in flash
        .toast(class=`toast-${f.type}` role=(f.type === 'error' ? 'alert' : 'status'))= f.message
    script(src="/javascripts/app.js" defer)
