mixin icon(name)
  svg.icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
    case name
      when 'folder'
        path(d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z")
      when 'plus'
        path(d="M12 5v14M5 12h14")
      when 'upload'
        path(d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12")
      when 'download'
        path(d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3")
      when 'trash'
        path(d="M3 6h18M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2")
      when 'edit'
        path(d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z")
      when 'logout'
        path(d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9")
      when 'menu'
        path(d="M3 6h18M3 12h18M3 18h18")
      when 'cloud'
        path(d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z")
      when 'x'
        path(d="M18 6L6 18M6 6l12 12")

mixin csrf
  input(type="hidden" name="_csrf" value=csrfToken)
