extends layout

block body
  main.auth
    .auth-card
      .auth-brand
        +icon('cloud')
        span FileUploader
      h1 Welcome back
      p.muted Log in to manage your files.

      form.stack(method="POST" action="/users/login")
        +csrf
        .field
          label(for="username") Username
          input#username(type="text" name="username" autocomplete="username" autofocus required)
        .field
          label(for="password") Password
          input#password(type="password" name="password" autocomplete="current-password" required)
        button.btn.btn-primary.btn-block(type="submit") Log in

      p.auth-alt.muted Don't have an account?
        |
        |
        a(href="/users/signup") Sign up
