extends layout

block body
  .app
    header.topbar
      button.icon-btn(type="button" data-sidebar-toggle aria-label="Open folders" aria-controls="sidebar" aria-expanded="false")
        +icon('menu')
      span.topbar-title= currentFolder.name

    aside#sidebar.sidebar
      .brand
        +icon('cloud')
        span FileUploader

      .sidebar-head
        span.eyebrow Folders
        button.icon-btn(type="button" data-open="newFolderDialog" aria-label="New folder" title="New folder")
          +icon('plus')

      nav.folder-list(aria-label="Folders")
        each folder in folders
          a.folder(href=`/folders?folder=${folder.id}` class=(folder.id === currentFolder.id ? 'active' : '') aria-current=(folder.id === currentFolder.id ? 'page' : false))
            +icon('folder')
            span.folder-name= folder.name
            span.count= folder._count.file

      .user-card
        .avatar(aria-hidden="true")= user.username.charAt(0).toUpperCase()
        span.user-name= user.username
        form(method="POST" action="/users/logout")
          +csrf
          button.icon-btn(type="submit" aria-label="Log out" title="Log out")
            +icon('logout')

    .scrim(data-sidebar-toggle hidden)

    main.main
      .page-head
        div
          h1= currentFolder.name
          p.muted #{files.length} #{files.length === 1 ? 'file' : 'files'} · #{formatBytes(totalSize)}
        .head-actions
          button.btn.btn-ghost(type="button" data-open="renameDialog")
            +icon('edit')
            | Rename
          button.btn.btn-ghost.btn-danger-text(type="button" data-open="deleteFolderDialog")
            +icon('trash')
            | Delete

      #dropzone.dropzone(data-folder-id=currentFolder.id data-max-mb=maxUploadMb tabindex="0" role="button" aria-label="Upload files: drop them here or press Enter to browse")
        input#fileInput(type="file" multiple hidden)
        .dz-icon
          +icon('upload')
        p.dz-title
          strong Drag &amp; drop files here
          |  or
          |
          span.link Browse
        p.hint Up to #{maxUploadMb} MB per file
        .progress(hidden)
          .progress-label
          .progress-track
            .progress-bar

      if files.length
        ul.file-list
          each file in files
            li.file-row
              .file-icon(class=`kind-${fileKind(file.name)}`)= (extension(file.name) || 'file').slice(0, 4)
              .file-main
                span.file-name(title=file.name)= file.name
                span.file-meta #{formatBytes(file.size)} · #{formatDate(file.createAt)}
              .file-actions
                a.icon-btn(href=`/files/${file.id}/download` aria-label=`Download ${file.name}` title="Download")
                  +icon('download')
                button.icon-btn.danger(type="button" data-delete-file=`/files/${file.id}/delete` data-name=file.name aria-label=`Delete ${file.name}` title="Delete")
                  +icon('trash')
      else
        .empty
          +icon('folder')
          h2 This folder is empty
          p.muted Drop a file above to add your first one.

  //- Dialogs
  dialog#newFolderDialog.dialog
    form(method="POST" action="/folders")
      +csrf
      .dialog-head
        h2 New folder
        button.icon-btn(type="button" data-close aria-label="Close")
          +icon('x')
      .field
        label(for="newFolderName") Folder name
        input#newFolderName(type="text" name="name" maxlength="60" placeholder="e.g. Tax documents" required)
      .dialog-foot
        button.btn.btn-ghost(type="button" data-close) Cancel
        button.btn.btn-primary(type="submit") Create folder

  dialog#renameDialog.dialog
    form(method="POST" action=`/folders/${currentFolder.id}/rename`)
      +csrf
      .dialog-head
        h2 Rename folder
        button.icon-btn(type="button" data-close aria-label="Close")
          +icon('x')
      .field
        label(for="renameName") Folder name
        input#renameName(type="text" name="name" maxlength="60" value=currentFolder.name required)
      .dialog-foot
        button.btn.btn-ghost(type="button" data-close) Cancel
        button.btn.btn-primary(type="submit") Save

  dialog#deleteFolderDialog.dialog
    form(method="POST" action=`/folders/${currentFolder.id}/delete`)
      +csrf
      .dialog-head
        h2 Delete folder?
        button.icon-btn(type="button" data-close aria-label="Close")
          +icon('x')
      p “#{currentFolder.name}” and its #{files.length} #{files.length === 1 ? 'file' : 'files'} will be permanently deleted. This can't be undone.
      .dialog-foot
        button.btn.btn-ghost(type="button" data-close) Cancel
        button.btn.btn-danger(type="submit") Delete folder

  dialog#deleteFileDialog.dialog
    form#deleteFileForm(method="POST")
      +csrf
      .dialog-head
        h2 Delete file?
        button.icon-btn(type="button" data-close aria-label="Close")
          +icon('x')
      p
        strong#deleteFileName
        |  will be permanently deleted.
      .dialog-foot
        button.btn.btn-ghost(type="button" data-close) Cancel
        button.btn.btn-danger(type="submit") Delete
