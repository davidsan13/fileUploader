# Postgres connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/fileuploader"

# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`)
SESSIONSECRET=

# Supabase Storage (use the service_role key – keep it server-side only)
SUPA_URL=https://your-project.supabase.co
SUPABASE_KEY=
SUPABASE_BUCKET=newFiles

# Optional
PORT=3000
MAX_UPLOAD_MB=25
